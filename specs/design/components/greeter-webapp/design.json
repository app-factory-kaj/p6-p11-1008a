{
  "name": "greeter-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "greeter-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    "F1.1",
    "F1.2",
    "F1.3",
    "F1.4"
  ],
  "description": "The whole product: a single-page React app that gates access behind Thunder sign-in, then offers a form with a name field and a Greet button that renders a greeting for the typed name directly in the browser. It calls no backend API and persists nothing — the greeting is computed locally and lost on refresh.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "thunder-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "p6-p11-1008a-thunder-auth",
        "envBindings": {
          "client_id": "THUNDER_AUTH_CLIENT_ID",
          "issuer": "THUNDER_AUTH_ISSUER",
          "jwks_url": "THUNDER_AUTH_JWKS_URL",
          "resource": "THUNDER_AUTH_RESOURCE",
          "scopes": "THUNDER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "wireframes",
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
